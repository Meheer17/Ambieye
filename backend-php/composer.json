{
    "name": "ambieye/backend-php",
    "description": "Ambieye Backend - PHP with MySQL",
    "version": "1.0.0",
    "require": {
        "php": "^7.4 || ^8.0",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Config\\": "src/config/",
            "Db\\": "src/db/",
            "Auth\\": "src/auth/",
            "Api\\": "src/api/",
            "Models\\": "src/models/"
        }
    }
}