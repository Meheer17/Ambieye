{
  "expo": {
    "name": "MindCare",
    "slug": "mindcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mindcare_logo_circle.png",
    "scheme": "mindcare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meheer17.ambieye",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mindcare_logo_circle.png",
        "backgroundColor": "#0A1128"
      },
      "package": "com.meheer17.ambieye"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/mindcare_logo_circle.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MindCare to access your camera for eye movement recording during exercises.",
          "microphonePermission": "Allow MindCare to access your microphone for voice recording during exercises.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1128",
          "image": "assets/images/mindcare_logo_circle.png",
          "imageWidth": 320,
          "imageResizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2c51b49-b94f-4c6d-a342-26e06dcc8092"
      }
    }
  }
}
